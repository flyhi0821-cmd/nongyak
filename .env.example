# 이 파일을 .env.local 로 복사해 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# Vercel 에는 Project Settings → Environment Variables 에 같은 이름으로 넣습니다.

# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) → SDK 설정 및 구성
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 서버 전용: Firebase 콘솔 → 서비스 계정 → 새 비공개 키(JSON)를 base64 로 인코딩한 값
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
FIREBASE_SERVICE_ACCOUNT_B64=

# 농약안전정보시스템 OpenAPI 키 (https://psis.rda.go.kr → 공공데이터개방 → OpenAPI 신청)
# 신청할 때 배포 도메인(예: xxx.vercel.app)을 등록해야 ERR_105 가 나지 않습니다.
PSIS_API_KEY=

# Vercel Cron 인증용 임의 문자열 (16자 이상)
CRON_SECRET=
